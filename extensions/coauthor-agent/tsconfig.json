{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"outDir": "./dist",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"types": []
	},
	"include": [
		"src/**/*",
		"../../src/vscode-dts/vscode.d.ts"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}
