{
  "name": "coauthor-agent",
  "displayName": "CoAuthor Agent",
  "description": "Local AI Assistant for CoAuthor",
  "version": "0.0.1",
  "publisher": "coauthor",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onChatParticipant:coauthor.agent"
  ],
  "contributes": {
    "chatParticipants": [
      {
        "id": "coauthor.agent",
        "name": "coauthor",
        "fullName": "CoAuthor Agent",
        "description": "Ask the CoAuthor AI Agent",
        "isDefault": true
      }
    ],
    "commands": [
      {
        "command": "coauthor.agent.clear",
        "title": "Clear Chat"
      }
    ],
    "configuration": {
      "title": "CoAuthor Agent",
      "properties": {
        "coauthor.agent.webhookUrl": {
          "type": "string",
          "default": "",
          "description": "The URL endpoint for the LLM webhook backend"
        },
        "coauthor.agent.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for authentication with the webhook"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  }
}
